# ---- Which LLM every project uses -------------------------------------------
# anthropic | openai | azure | do | fake   (fake = offline, no key, for smoke tests)
LLM_PROVIDER=anthropic
# Optional model override. Defaults: anthropic=claude-opus-5-5, openai=gpt-5-mini,
# do=llama3.3-70b-instruct. Cheaper Claude for experiments: claude-haiku-5-5
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Azure OpenAI (LLM_PROVIDER=azure). LLM_MODEL = your deployment name
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2025-04-01-preview

# DigitalOcean AI Platform serverless inference (LLM_PROVIDER=do) - OpenAI-compatible
DO_MODEL_ACCESS_KEY=
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1

# ---- Embeddings: fastembed (local, free) | openai | fake ---------------------
EMBEDDINGS_PROVIDER=fastembed

# ---- Langfuse observability (leave blank to disable tracing) -----------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud EU: https://cloud.langfuse.com  | US: https://us.cloud.langfuse.com
# Self-hosted on DigitalOcean: http://<droplet-ip>:3000
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- Retrieval and routing ---------------------------------------------------
# RETRIEVER: bm25 (pure Python, serverless-friendly) | vector (Chroma + FastEmbed). Default: vector
RETRIEVER=
# ROUTER: heuristic (rules, no extra LLM call) | llm (small model picks the tier). Default: heuristic
ROUTER=

# ---- Multi-provider LLMs: free tiers and cheap APIs --------------------------
# Each provider is enabled by setting its key. Blank = disabled. Full list, signup links and
# caveats: docs/PROVIDERS.md. Check everything with: python -m common.providers
#
# Optional model overrides: set <NAME>_MODEL, where NAME is the provider key in
# common/providers.py in upper case (e.g. GROQ_MODEL, HUGGINGFACE_MODEL, ZAI_MODEL,
# DASHSCOPE_MODEL). An override replaces the model for every tier of that provider.
# Find current model ids with: python -m common.providers --discover
#
# Vercel AI Gateway (Claude via Vercel). Set one of these locally; on Vercel, VERCEL_OIDC_TOKEN
# is injected automatically at runtime, so do not set it by hand.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
SILICONFLOW_API_KEY=
MISTRAL_API_KEY=
# GitHub Models: a personal access token with models:read
GITHUB_MODELS_TOKEN=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
# Hugging Face Inference Providers
HF_TOKEN=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
# Cloudflare Workers AI needs both values
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- Claude Managed Agents (projects/07) -------------------------------------
# Created once by the setup script, then reused. Leave blank until then.
MANAGED_AGENT_ID=
MANAGED_AGENT_VERSION=
MANAGED_ENVIRONMENT_ID=

# ---- Hosted showcase access --------------------------------------------------
# Shared secret for the protected endpoints of the hosted app. Pick any long random string.
APP_API_KEY=
